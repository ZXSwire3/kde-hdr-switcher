#!/usr/bin/env python3
"""HDR tray controller for KDE Plasma.

Shows a persistent status notifier icon in the system tray and exposes
right-click actions for HDR control.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("AppIndicator3", "0.1")
from gi.repository import AppIndicator3, GLib, Gtk


APP_ID = "hdr-switcher-tray"
APP_NAME = "HDR Switcher Tray"
DEFAULT_OFF_BRIGHTNESS = 100
BRIGHTNESS_STEP = 10
CONFIG_DIR = Path.home() / ".config" / "hdr-switcher"
CONFIG_FILE = CONFIG_DIR / "config.json"


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="hdr-switcher-tray",
        description="System tray HDR controller for KDE Plasma.",
    )
    parser.add_argument(
        "--no-notify",
        action="store_true",
        help="Suppress notifications from hdr-switcher actions.",
    )
    parser.add_argument(
        "--refresh-seconds",
        type=int,
        default=8,
        metavar="N",
        help="Polling interval for state refresh (default: 8).",
    )
    return parser


def find_hdr_switcher() -> str:
    candidates: list[Path] = []
    env = os.environ.get("HDR_SWITCHER_BIN")
    if env:
        candidates.append(Path(env))
    candidates.append(Path(__file__).resolve().with_name("hdr-switcher"))
    candidates.append(Path.home() / ".local/bin/hdr-switcher")
    for candidate in candidates:
        if candidate.is_file():
            return str(candidate)
    found = shutil.which("hdr-switcher")
    if found:
        return found
    raise RuntimeError("Unable to locate hdr-switcher binary.")


def icon_for_state(state: str) -> str | None:
    icon_name = "hdr-on.png" if state == "on" else "hdr-off.png"
    env_icon_dir = os.environ.get("HDR_SWITCHER_ICON_DIR")
    search_paths: list[Path] = []
    if env_icon_dir:
        search_paths.append(Path(env_icon_dir))
    search_paths.append(Path.home() / ".local/share/hdr-switcher/images")
    search_paths.append(Path(__file__).resolve().parent.parent / "images")
    for icon_dir in search_paths:
        icon_path = icon_dir / icon_name
        if icon_path.is_file():
            return str(icon_path)
    return None


def parse_state(output: str) -> str:
    text = output.upper()
    if "HDR STATE: ON" in text:
        return "on"
    if "HDR STATE: MIXED" in text:
        return "mixed"
    if "HDR STATE: OFF" in text:
        return "off"
    return "none"


def load_settings() -> dict:
    settings: dict = {"off_brightness": DEFAULT_OFF_BRIGHTNESS, "on_brightness": None, "suspend_night_light": False}
    try:
        payload = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
        off_raw = payload.get("off_brightness", DEFAULT_OFF_BRIGHTNESS)
        try:
            off_val = int(off_raw)
            if 0 <= off_val <= 100:
                settings["off_brightness"] = off_val
        except (TypeError, ValueError):
            pass
        on_raw = payload.get("on_brightness")
        if on_raw is not None:
            try:
                on_val = int(on_raw)
                if 0 <= on_val <= 100:
                    settings["on_brightness"] = on_val
            except (TypeError, ValueError):
                pass
        settings["suspend_night_light"] = bool(payload.get("suspend_night_light", False))
    except (FileNotFoundError, OSError, ValueError, TypeError, json.JSONDecodeError):
        pass
    return settings


def save_settings(settings: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    # Omit keys whose value is None so the config file stays clean
    to_save = {k: v for k, v in settings.items() if v is not None}
    # Always persist suspend_night_light even when False
    if "suspend_night_light" in settings:
        to_save["suspend_night_light"] = settings["suspend_night_light"]
    CONFIG_FILE.write_text(f"{json.dumps(to_save, indent=2)}\n", encoding="utf-8")


class HdrTray:
    def __init__(self, switcher_path: str, notify_enabled: bool, refresh_seconds: int) -> None:
        self.switcher_path = switcher_path
        self.notify_enabled = notify_enabled
        self.refresh_seconds = max(2, refresh_seconds)
        self.settings = load_settings()
        self.off_brightness = int(self.settings.get("off_brightness", DEFAULT_OFF_BRIGHTNESS))
        if not 0 <= self.off_brightness <= 100:
            self.off_brightness = DEFAULT_OFF_BRIGHTNESS
        self.on_brightness: int | None = self.settings.get("on_brightness")
        if self.on_brightness is not None and not 0 <= self.on_brightness <= 100:
            self.on_brightness = None
        self.suspend_night_light: bool = bool(self.settings.get("suspend_night_light", False))
        self._syncing_controls = False

        self.indicator = AppIndicator3.Indicator.new(
            APP_ID,
            "video-display",
            AppIndicator3.IndicatorCategory.APPLICATION_STATUS,
        )
        self.indicator.set_status(AppIndicator3.IndicatorStatus.ACTIVE)
        self.indicator.set_title(APP_NAME)

        self.menu = Gtk.Menu()
        self.state_item = Gtk.MenuItem(label="HDR: unknown")
        self.state_item.set_sensitive(False)
        self.menu.append(self.state_item)
        self.menu.append(Gtk.SeparatorMenuItem())

        self.enable_item = Gtk.MenuItem(label="Enable HDR")
        self.enable_item.connect("activate", self._on_action, "on")
        self.menu.append(self.enable_item)

        self.disable_item = Gtk.MenuItem(label="Disable HDR")
        self.disable_item.connect("activate", self._on_action, "off")
        self.menu.append(self.disable_item)

        self.toggle_item = Gtk.MenuItem(label="Toggle HDR")
        self.toggle_item.connect("activate", self._on_action, "toggle")
        self.menu.append(self.toggle_item)

        self.settings_item = Gtk.MenuItem(label="Settings")
        self.settings_menu = Gtk.Menu()
        self.settings_item.set_submenu(self.settings_menu)
        self.menu.append(self.settings_item)

        # --- HDR-off brightness section ---
        self.off_section_item = Gtk.MenuItem(label="When HDR turns OFF")
        self.off_section_item.set_sensitive(False)
        self.settings_menu.append(self.off_section_item)
        self.brightness_info_item = Gtk.MenuItem(label="")
        self.brightness_info_item.set_sensitive(False)
        self.settings_menu.append(self.brightness_info_item)
        self.off_range_hint_item = Gtk.MenuItem(label="Range: 0-100%")
        self.off_range_hint_item.set_sensitive(False)
        self.settings_menu.append(self.off_range_hint_item)
        self.off_controls_item, self.off_scale, self.off_spin = self._build_brightness_controls(
            value=self.off_brightness,
            on_slider_changed=self._on_off_slider_changed,
            on_slider_apply=self._on_off_slider_apply,
            on_spin_changed=self._on_off_spin_changed,
            on_spin_apply=self._on_off_spin_apply,
            on_decrease=self._on_off_decrease,
            on_increase=self._on_off_increase,
        )
        self.settings_menu.append(self.off_controls_item)
        self.off_reset_item = Gtk.MenuItem(label="Reset HDR-off brightness to default (100%)")
        self.off_reset_item.connect("activate", self._on_reset_off_brightness)
        self.settings_menu.append(self.off_reset_item)

        # --- HDR-on brightness section ---
        self.settings_menu.append(Gtk.SeparatorMenuItem())
        self.on_section_item = Gtk.MenuItem(label="When HDR turns ON")
        self.on_section_item.set_sensitive(False)
        self.settings_menu.append(self.on_section_item)
        self.on_brightness_info_item = Gtk.MenuItem(label="")
        self.on_brightness_info_item.set_sensitive(False)
        self.settings_menu.append(self.on_brightness_info_item)
        self.on_range_hint_item = Gtk.MenuItem(label="Range: 0-100%")
        self.on_range_hint_item.set_sensitive(False)
        self.settings_menu.append(self.on_range_hint_item)
        self.enable_on_brightness_item = Gtk.CheckMenuItem(label="Set brightness when HDR turns ON")
        self.enable_on_brightness_item.set_active(self.on_brightness is not None)
        self.enable_on_brightness_item.connect("toggled", self._on_enable_on_brightness_toggled)
        self.settings_menu.append(self.enable_on_brightness_item)
        self.on_controls_item, self.on_scale, self.on_spin = self._build_brightness_controls(
            value=self.on_brightness if self.on_brightness is not None else DEFAULT_OFF_BRIGHTNESS,
            on_slider_changed=self._on_on_slider_changed,
            on_slider_apply=self._on_on_slider_apply,
            on_spin_changed=self._on_on_spin_changed,
            on_spin_apply=self._on_on_spin_apply,
            on_decrease=self._on_on_decrease,
            on_increase=self._on_on_increase,
        )
        self.settings_menu.append(self.on_controls_item)
        self.on_reset_item = Gtk.MenuItem(label="Reset HDR-on brightness to default (100%)")
        self.on_reset_item.connect("activate", self._on_reset_on_brightness)
        self.settings_menu.append(self.on_reset_item)

        # --- Night Light suspension ---
        self.settings_menu.append(Gtk.SeparatorMenuItem())
        self.suspend_night_light_item = Gtk.CheckMenuItem(label="Suspend Night Light")
        self.suspend_night_light_item.set_active(self.suspend_night_light)
        self.suspend_night_light_item.connect("toggled", self._on_suspend_night_light_toggled)
        self.settings_menu.append(self.suspend_night_light_item)

        self.refresh_item = Gtk.MenuItem(label="Refresh Status")
        self.refresh_item.connect("activate", self._on_refresh)
        self.menu.append(self.refresh_item)

        self.menu.append(Gtk.SeparatorMenuItem())
        self.quit_item = Gtk.MenuItem(label="Quit")
        self.quit_item.connect("activate", self._on_quit)
        self.menu.append(self.quit_item)

        self.menu.show_all()
        self.indicator.set_menu(self.menu)

        self._sync_settings_menu()
        self.refresh_state()
        GLib.timeout_add_seconds(self.refresh_seconds, self._periodic_refresh)

    def _run(self, args: list[str]) -> tuple[int, str]:
        try:
            res = subprocess.run(
                [self.switcher_path, *args],
                check=False,
                capture_output=True,
                text=True,
            )
        except OSError as exc:
            return 127, str(exc)
        output = (res.stdout or "").strip()
        err = (res.stderr or "").strip()
        return res.returncode, output if output else err

    def refresh_state(self) -> None:
        code, text = self._run(["status", "--no-notify"])
        state = parse_state(text)
        self._set_icon(state)
        if code == 0:
            self.state_item.set_label(f"HDR: {state.upper()}")
        elif text:
            self.state_item.set_label(f"HDR: {text}")
        else:
            self.state_item.set_label("HDR: unavailable")

    def _set_icon(self, state: str) -> None:
        icon_path = icon_for_state("on" if state == "on" else "off")
        if icon_path:
            self.indicator.set_icon_full(icon_path, f"HDR {state}")
        else:
            self.indicator.set_icon_full("video-display", f"HDR {state}")

    def _on_action(self, _menu_item: Gtk.MenuItem, action: str) -> None:
        args = [action]
        if action in {"off", "toggle"}:
            args.extend(["--off-brightness", str(self.off_brightness)])
        if action in {"on", "toggle"}:
            if self.on_brightness is not None:
                args.extend(["--on-brightness", str(self.on_brightness)])
            else:
                args.append("--no-on-brightness")
        if self.suspend_night_light:
            args.append("--suspend-night-light")
        else:
            args.append("--no-suspend-night-light")
        if not self.notify_enabled:
            args.append("--no-notify")
        self._run(args)
        self.refresh_state()

    def _on_refresh(self, _menu_item: Gtk.MenuItem) -> None:
        self.refresh_state()

    def _periodic_refresh(self) -> bool:
        self.refresh_state()
        return True

    def _build_brightness_controls(
        self,
        value: int,
        on_slider_changed,
        on_slider_apply,
        on_spin_changed,
        on_spin_apply,
        on_decrease,
        on_increase,
    ) -> tuple[Gtk.MenuItem, Gtk.Scale, Gtk.SpinButton]:
        item = Gtk.MenuItem()
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        box.set_border_width(4)

        dec_button = Gtk.Button.new_with_label("-10")
        dec_button.set_relief(Gtk.ReliefStyle.NONE)
        dec_button.connect("clicked", on_decrease)
        box.pack_start(dec_button, False, False, 0)

        adjustment = Gtk.Adjustment(value=value, lower=0, upper=100, step_increment=1, page_increment=10, page_size=0)
        scale = Gtk.Scale.new(Gtk.Orientation.HORIZONTAL, adjustment)
        scale.set_digits(0)
        scale.set_draw_value(False)
        scale.set_hexpand(True)
        scale.set_size_request(180, -1)
        scale.set_increments(1, BRIGHTNESS_STEP)
        for mark in range(0, 101, BRIGHTNESS_STEP):
            scale.add_mark(mark, Gtk.PositionType.BOTTOM, None)
        scale.connect("value-changed", on_slider_changed)
        scale.connect("button-release-event", on_slider_apply)
        scale.connect("key-release-event", on_slider_apply)
        box.pack_start(scale, True, True, 0)

        inc_button = Gtk.Button.new_with_label("+10")
        inc_button.set_relief(Gtk.ReliefStyle.NONE)
        inc_button.connect("clicked", on_increase)
        box.pack_start(inc_button, False, False, 0)

        spin = Gtk.SpinButton.new_with_range(0, 100, 1)
        spin.set_numeric(True)
        spin.set_update_policy(Gtk.SpinButtonUpdatePolicy.IF_VALID)
        spin.set_width_chars(4)
        spin.set_value(float(value))
        spin.connect("value-changed", on_spin_changed)
        spin.connect("activate", on_spin_apply)
        spin.connect("focus-out-event", on_spin_apply)
        box.pack_start(spin, False, False, 0)

        item.add(box)
        return item, scale, spin

    @staticmethod
    def _clamp_brightness(value: int) -> int:
        return max(0, min(100, value))

    def _sync_slider_spin(self, scale: Gtk.Scale, spin: Gtk.SpinButton, value: int) -> None:
        self._syncing_controls = True
        scale.set_value(float(value))
        spin.set_value(float(value))
        self._syncing_controls = False

    def _set_on_controls_enabled(self, enabled: bool) -> None:
        self.on_controls_item.set_sensitive(enabled)
        self.on_reset_item.set_sensitive(enabled)

    def _sync_settings_menu(self) -> None:
        self.brightness_info_item.set_label(f"Current: {self.off_brightness}%")
        self._sync_slider_spin(self.off_scale, self.off_spin, self.off_brightness)

        on_label = f"{self.on_brightness}%" if self.on_brightness is not None else "Disabled"
        self.on_brightness_info_item.set_label(f"Current: {on_label}")
        self._sync_slider_spin(
            self.on_scale,
            self.on_spin,
            self.on_brightness if self.on_brightness is not None else int(self.on_scale.get_value()),
        )
        self._syncing_controls = True
        self.enable_on_brightness_item.set_active(self.on_brightness is not None)
        self._syncing_controls = False
        self._set_on_controls_enabled(self.on_brightness is not None)

    def _set_off_brightness(self, value: int) -> None:
        value = self._clamp_brightness(value)
        self.off_brightness = value
        self.settings["off_brightness"] = value
        try:
            save_settings(self.settings)
        except OSError:
            pass
        self._sync_settings_menu()

    def _set_on_brightness(self, value: int | None) -> None:
        if value is not None:
            value = self._clamp_brightness(value)
        self.on_brightness = value
        self.settings["on_brightness"] = value
        try:
            save_settings(self.settings)
        except OSError:
            pass
        self._sync_settings_menu()

    def _set_suspend_night_light(self, value: bool) -> None:
        self.suspend_night_light = value
        self.settings["suspend_night_light"] = value
        try:
            save_settings(self.settings)
        except OSError:
            pass

    def _on_suspend_night_light_toggled(self, menu_item: Gtk.CheckMenuItem) -> None:
        self._set_suspend_night_light(menu_item.get_active())

    def _on_off_slider_changed(self, scale: Gtk.Scale) -> None:
        if self._syncing_controls:
            return
        self._sync_slider_spin(scale, self.off_spin, int(round(scale.get_value())))

    def _on_off_slider_apply(self, scale: Gtk.Scale, *_args) -> bool:
        self._set_off_brightness(int(round(scale.get_value())))
        return False

    def _on_off_spin_changed(self, spin: Gtk.SpinButton) -> None:
        if self._syncing_controls:
            return
        self._sync_slider_spin(self.off_scale, spin, spin.get_value_as_int())

    def _on_off_spin_apply(self, spin: Gtk.SpinButton, *_args) -> bool:
        self._set_off_brightness(spin.get_value_as_int())
        return False

    def _on_off_decrease(self, _button: Gtk.Button) -> None:
        self._set_off_brightness(self.off_brightness - BRIGHTNESS_STEP)

    def _on_off_increase(self, _button: Gtk.Button) -> None:
        self._set_off_brightness(self.off_brightness + BRIGHTNESS_STEP)

    def _on_reset_off_brightness(self, _menu_item: Gtk.MenuItem) -> None:
        self._set_off_brightness(DEFAULT_OFF_BRIGHTNESS)

    def _on_enable_on_brightness_toggled(self, menu_item: Gtk.CheckMenuItem) -> None:
        if self._syncing_controls:
            return
        if menu_item.get_active():
            self._set_on_brightness(self.on_spin.get_value_as_int())
        else:
            self._set_on_brightness(None)

    def _on_on_slider_changed(self, scale: Gtk.Scale) -> None:
        if self._syncing_controls:
            return
        self._sync_slider_spin(scale, self.on_spin, int(round(scale.get_value())))

    def _on_on_slider_apply(self, scale: Gtk.Scale, *_args) -> bool:
        if self.on_brightness is None:
            return False
        self._set_on_brightness(int(round(scale.get_value())))
        return False

    def _on_on_spin_changed(self, spin: Gtk.SpinButton) -> None:
        if self._syncing_controls:
            return
        self._sync_slider_spin(self.on_scale, spin, spin.get_value_as_int())

    def _on_on_spin_apply(self, spin: Gtk.SpinButton, *_args) -> bool:
        if self.on_brightness is None:
            return False
        self._set_on_brightness(spin.get_value_as_int())
        return False

    def _on_on_decrease(self, _button: Gtk.Button) -> None:
        base = self.on_brightness if self.on_brightness is not None else self.on_spin.get_value_as_int()
        next_val = self._clamp_brightness(base - BRIGHTNESS_STEP)
        if self.on_brightness is None:
            self._sync_slider_spin(self.on_scale, self.on_spin, next_val)
            return
        self._set_on_brightness(next_val)

    def _on_on_increase(self, _button: Gtk.Button) -> None:
        base = self.on_brightness if self.on_brightness is not None else self.on_spin.get_value_as_int()
        next_val = self._clamp_brightness(base + BRIGHTNESS_STEP)
        if self.on_brightness is None:
            self._sync_slider_spin(self.on_scale, self.on_spin, next_val)
            return
        self._set_on_brightness(next_val)

    def _on_reset_on_brightness(self, _menu_item: Gtk.MenuItem) -> None:
        self._set_on_brightness(DEFAULT_OFF_BRIGHTNESS)

    def _on_quit(self, _menu_item: Gtk.MenuItem) -> None:
        Gtk.main_quit()


def main() -> int:
    args = build_parser().parse_args()
    try:
        switcher = find_hdr_switcher()
    except RuntimeError as exc:
        print(f"{APP_NAME}: {exc}", file=sys.stderr)
        return 2

    HdrTray(
        switcher_path=switcher,
        notify_enabled=not args.no_notify,
        refresh_seconds=args.refresh_seconds,
    )
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
